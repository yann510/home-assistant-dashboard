{
  "id": "1689080467859",
  "alias": "Close all the lights when leaving home",
  "description": "Turn lights off only after known away status and confirmed office vacancy both hold continuously for five minutes. Unknown or unavailable presence is fail-safe; later confirmed vacancy starts a fresh countdown.",
  "triggers": [
    {
      "trigger": "template",
      "value_template": "{{ states('person.yann_thibodeau') not in ['home', 'unknown', 'unavailable', ''] and is_state('binary_sensor.aqara_fp2_presence_motion_sensor_presence_sensor_2', 'off') }}",
      "for": {
        "minutes": 5
      }
    }
  ],
  "conditions": [
