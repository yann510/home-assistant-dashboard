+def _register_native_services(hass):
+    handlers = NativeServiceHandlers(hass, DOMAIN, NativeSnapshot)
+    target_fields = {
+        vol.Optional("device_id"): cv.string,
+        vol.Optional("entity_id"): cv.entity_id,
+        vol.Optional("entry_id"): cv.string,
+    }
+    for name, handler, schema in (
+        ("capture_native_state", handlers.capture, vol.Schema(target_fields)),
+        ("restore_native_state", handlers.restore,
+         vol.Schema({**target_fields, vol.Required("snapshot"): dict})),
+    ):
+        if not hass.services.has_service(DOMAIN, name):
+            hass.services.async_register(
+                DOMAIN, name, handler, schema=schema,
+                supports_response=SupportsResponse.ONLY,
+            )
